# Log files
**/*.log

# dotenv environment variables file
**/.env

# Packed extensions and their signing keys. A .pem file is the private key
# of a packed extension and must never be committed.
*.crx
*.pem
*.zip

# Dependencies, if a tool is ever installed locally
node_modules/

# JetBrains IDEs
**/.idea/
**/*.iml

# AI
.claude/worktree
.claude/*.local.json

# Visual Studio Code IDE
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/extensions.json
!**/.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Generated by MacOS
.DS_Store
.AppleDouble
.LSOverride

# Generated by Windows
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Build output
dist/
